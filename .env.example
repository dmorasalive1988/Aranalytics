# ---------- Modo ----------
# demo = datos ficticios, pago simulado y correos visibles en /demo/correo (predeterminado en Vercel) · production
PLUMA_MODE=

# ---------- Base de datos ----------
# Local: cualquier PostgreSQL 16 (pnpm db:migrate aplica la capa de compatibilidad con Supabase)
# Producción: cadena de conexión de Supabase (pooler en modo transacción, puerto 6543)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pluma

# ---------- URLs públicas ----------
PLUMA_APP_URL=http://localhost:3000
# Enlaces de firma de coautores (por defecto, ${PLUMA_APP_URL}/firmar)
PLUMA_SIGN_URL=http://localhost:3000/firmar
PLUMA_ADMIN_URL=http://localhost:3001

# ---------- Secretos ----------
# Firma enlaces de coautores, URLs de almacenamiento local y sesiones de desarrollo. Obligatorio en producción.
PLUMA_SIGNING_SECRET=
# Clave AES-256 para ID fiscal y datos bancarios (32 bytes en base64: openssl rand -base64 32). Obligatoria en producción.
PLUMA_DATA_KEY=

# ---------- Autenticación ----------
# dev = cuentas locales con código por correo (solo desarrollo) · supabase = Supabase Auth
PLUMA_AUTH_MODE=dev
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Pagos (membresía) ----------
# fake = checkout simulado (desarrollo y pruebas) · stripe
PLUMA_PAYMENTS=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Precios anuales creados en Stripe (deben coincidir con plan_prices.stripe_price_id)
STRIPE_PRICE_SOCIO=
STRIPE_PRICE_PRO=

# ---------- Correo ----------
# dev = guarda los correos en .dev-mail/ · postmark
PLUMA_EMAIL=dev
POSTMARK_TOKEN=
PLUMA_EMAIL_FROM="Pluma <hola@pluma.mu>"
# Contraseña del webhook de Postmark (entregas, aperturas, rebotes): https://pluma:<secreto>@…/api/webhooks/postmark
POSTMARK_WEBHOOK_SECRET=

# ---------- Almacenamiento ----------
# local = .dev-storage/ · supabase = Supabase Storage (buckets privados)
PLUMA_STORAGE=local

# ---------- Sello de tiempo RFC 3161 (prueba de autoría y evidencia de firmas) ----------
# Vacío = desactivado. Ej.: https://freetsa.org/tsr
PLUMA_TSA_URL=

# ---------- Notificaciones ----------
# 1 = la app despacha el outbox al responder (desarrollo, sin worker). En producción lo hace el worker.
PLUMA_INLINE_DISPATCH=1

# Push (Web Push con VAPID): npx web-push generate-vapid-keys. Vacío en desarrollo = push guardado en .dev-push/.
PLUMA_VAPID_PUBLIC=
PLUMA_VAPID_PRIVATE=
PLUMA_VAPID_SUBJECT=mailto:soporte@pluma.mu

# WhatsApp (opcional): off (por defecto) · dev = guarda los mensajes en .dev-whatsapp/ · meta = WhatsApp Cloud API
PLUMA_WHATSAPP=off
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

# ---------- Pluma Sync ----------
# Opcional: con una clave, un modelo traduce las búsquedas en lenguaje natural a filtros (sin ella, reglas)
ANTHROPIC_API_KEY=

# ---------- Sitio público (/es, /en, /pt) ----------
# URL pública del sitio para canonical, hreflang, sitemap e imágenes OG (por defecto, la del dominio de producción en Vercel)
PLUMA_SITE_URL=
# 1 = lanzamiento con lista de espera: "Hazte socio" lleva a un formulario de correo (se aplica al volver a desplegar)
PLUMA_WAITLIST=
# Correo del equipo que recibe los avisos de lista de espera y formularios de sync y A&R
PLUMA_TEAM_EMAIL=
# URL del back-office, para el enlace "Ver contactos" del aviso
PLUMA_ADMIN_URL=
