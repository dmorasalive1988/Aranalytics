{
  "name": "@pluma/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "migrate": "tsx src/cli/migrate.ts",
    "reset": "tsx src/cli/reset.ts",
    "introspect": "drizzle-kit pull && node scripts/postprocess-schema.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@pluma/domain": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
